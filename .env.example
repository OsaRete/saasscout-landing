# Public application URLs
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private provider/API secrets
OPENROUTER_API_KEY=
SERPAPI_API_KEY=
X_BEARER_TOKEN=

# Private Supabase server secret
SUPABASE_SERVICE_ROLE_KEY=

# Private route/internal auth secrets
CRON_SECRET=
INTERNAL_API_SECRET=

# Discovery / Data Moat feature flags
# Accepted values: "1" to enable; unset or any other value disables
KNOWLEDGE_EVOLUTION_DUAL_WRITE=
DISCOVERY_ORCHESTRATOR_ASSISTED_PERSISTENCE=
KNOWLEDGE_EVOLUTION_DIAGNOSTICS=
DISCOVERY_ORCHESTRATOR_DIAGNOSTICS=
SOLUTION_INTELLIGENCE_DIAGNOSTICS=
PROBLEM_SYNTHESIS_MULTI_CANDIDATE_DIAGNOSTICS=

# Snapshot flags
# Accepted values: "1" to enable; unset or any other value disables
SNAPSHOT_PERSISTENCE_ENABLED=
# Accepted values: "disabled", "shadow"
SNAPSHOT_RETRIEVAL_MODE=

# Scan workflow flags
# Accepted values: "true" to enable; unset or any other value disables
SCAN_SERVER_WORKFLOW_ENABLED=
# Comma-separated Supabase user UUIDs
SCAN_SERVER_WORKFLOW_ALLOWED_USER_IDS=
# Accepted values: "true" to enable; unset or any other value disables
SCAN_ARTIFACT_PERSISTENCE_SHADOW_ENABLED=

# Local-only Scan Artifact PostgreSQL integration tests
# Never point these variables at Preview or Production databases.
SCAN_ARTIFACT_TEST_DATABASE_URL=
SCAN_ARTIFACT_TEST_DB_CONTAINER=
SCAN_ARTIFACT_TEST_DATABASE_PORT=
